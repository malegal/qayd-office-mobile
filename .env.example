# متغيّرات بيئة تطبيق الهاتف (qayd-office-mobile)
# انسخ هذا الملف إلى .env ثم املأ القيم من مشروع Supabase الخاص بالمكتب.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# (اختياري) مسار النشر العام لنسخة الويب فقط، يُمرَّر وقت البناء:
# EXPO_BASE_URL=/my-subpath
